DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/stayboard"

# 운영에서 하위 경로로 배포할 때만 설정합니다. 로컬 개발에서는 비워 둡니다.
NEXT_PUBLIC_BASE_PATH=

# 기본 경로 배포: http://localhost:3004/api/auth
# /stayboard 배포: https://example.com/stayboard/api/auth
NEXTAUTH_URL="http://localhost:3004"
NEXTAUTH_SECRET=

INITIAL_DEVELOPER_USERNAME=shinseungmin193
INITIAL_DEVELOPER_EMAIL=developer@staysync.local
INITIAL_DEVELOPER_PASSWORD=
INITIAL_DEVELOPER_NAME="StayBoard Developer"

# 인증 도입 전 로컬 개발에서만 사용하는 서버 전용 접근 정책입니다.
# production에서는 아래 값과 관계없이 fallback 접근이 항상 거부됩니다.
STAYBOARD_DEV_ACCESS_ENABLED=false
STAYBOARD_DEV_ACCESS_ROLE=DEVELOPER
# 개발 중 사용자별 Preference를 구분하는 안정적인 식별자입니다.
STAYBOARD_DEV_ACCESS_USER_ID=local-developer
# ADMIN 또는 STAFF는 접근 가능한 Company ID를 쉼표로 구분해 지정해야 합니다.
STAYBOARD_DEV_ACCESS_COMPANY_IDS=

# 로그인한 ACTIVE DEVELOPER가 ADMIN/STAFF 권한 테스트를 사용할 환경에서만 true로 설정합니다.
# production에서도 사용할 수 있는 서버 전용 opt-in이며 기본값은 false입니다.
ENABLE_DEVELOPER_ROLE_SWITCH=false
