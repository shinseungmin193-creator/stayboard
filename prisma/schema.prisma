generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CalendarProviderType {
  AIRBNB
  BOOKING
  AGODA
  EXPEDIA
  VRBO
  OTHER
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  BLOCKED
  TENTATIVE
  UNKNOWN
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
}

enum SyncExecutionMode {
  AUTO
  MANUAL
}

enum CalendarConnectionStatus {
  NORMAL
  RECONNECT_REQUIRED
}

enum ReservationConflictStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum RoomOperationalStatus {
  NONE
  CLEANING_REQUIRED
  INSPECTION_REQUIRED
}

enum CleaningTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CleaningTaskLogAction {
  ASSIGNED
  REASSIGNED
  STARTED
  START_CANCELLED
  COMPLETED
  NOTE_ADDED
  PHOTO_ADDED
}

enum RoomNoteSourceType {
  MANUAL
  CLEANING
}

enum RoomNoteStatus {
  OPEN
  COMPLETED
}

enum GuestFallbackMode {
  PROVIDER
  GENERIC
}

enum UserSystemRole {
  NONE
  DEVELOPER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CompanyMemberRole {
  ADMIN
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum InvitationCodeStatus {
  ACTIVE
  USED
  REVOKED
}

model Company {
  id                          String                       @id @default(cuid())
  name                        String
  isActive                    Boolean                      @default(true)
  suspendedAt                 DateTime?
  suspendedById               String?
  suspensionReason            String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  properties                  Property[]
  settings                    CompanySettings?
  memberships                 CompanyMembership[]
  invitationCodes             InvitationCode[]
  cleaningTasks               CleaningTask[]
  cleaningWorkers             CleaningWorker[]
  roomNotes                   RoomNote[]
  developerRoleSessions       DeveloperRoleSession[]
  mobileNavigationPreferences MobileNavigationPreference[]
  suspendedBy                 User?                        @relation("CompanySuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  auditLogs                   AuditLog[]

  @@index([isActive, name])
  @@index([suspendedById])
}

model MobileNavigationPreference {
  id        String            @id @default(cuid())
  companyId String
  role      CompanyMemberRole
  itemOrder Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role])
  @@index([companyId])
}

model CompanySettings {
  id                             String            @id @default(cuid())
  companyId                      String            @unique
  timezone                       String            @default("Asia/Tokyo")
  defaultCheckInTime             String            @default("15:00")
  defaultCheckOutTime            String            @default("10:00")
  nextReservationDisplayDays     Int               @default(7)
  showFutureReservationsAsVacant Boolean           @default(true)
  showBlockedAsRoomStatus        Boolean           @default(false)
  conflictDisplayLabel           String            @default("오버부킹")
  guestFallbackMode              GuestFallbackMode @default(PROVIDER)
  showNextReservationOnVacant    Boolean           @default(true)
  cleaningStatusEnabled          Boolean           @default(true)
  inspectionStatusEnabled        Boolean           @default(true)
  autoMarkCleaningRequired       Boolean           @default(false)
  showSyncFailureWarnings        Boolean           @default(true)
  showSyncSuccessMessage         Boolean           @default(false)
  recentSyncLogLimit             Int               @default(10)
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt
  company                        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SidebarPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  menuOrder     Json
  hiddenMenuIds Json
  customLabels  Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Property {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  address          String
  timezone         String            @default("Asia/Tokyo")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rooms            Room[]
  reservations     Reservation[]
  staffAssignments StaffAssignment[]
  propertyAccesses PropertyAccess[]
  cleaningTasks    CleaningTask[]
  roomNotes        RoomNote[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([isActive, name])
}

model Room {
  id                         String                @id @default(cuid())
  propertyId                 String
  name                       String
  code                       String
  capacity                   Int                   @default(1)
  sortOrder                  Int                   @default(0)
  isActive                   Boolean               @default(true)
  operationalStatus          RoomOperationalStatus @default(NONE)
  operationalStatusUpdatedAt DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  property                   Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  calendarSources            CalendarSource[]
  listings                   RoomListing[]
  reservations               Reservation[]
  conflicts                  ReservationConflict[]
  staffAssignments           StaffAssignment[]
  syncRuns                   SyncRun[]
  cleaningTasks              CleaningTask[]
  roomNotes                  RoomNote[]

  @@unique([propertyId, code])
  @@index([propertyId, isActive, sortOrder])
  @@index([isActive])
  @@index([operationalStatus, isActive])
}

model User {
  id                      String                 @id @default(cuid())
  username                String?                @unique
  email                   String                 @unique
  name                    String
  passwordHash            String?
  systemRole              UserSystemRole         @default(NONE)
  isActive                Boolean                @default(true)
  status                  UserStatus             @default(ACTIVE)
  sessionVersion          Int                    @default(0)
  suspendedAt             DateTime?
  suspendedById           String?
  suspensionReason        String?
  deletedAt               DateTime?
  deletedById             String?
  deletionReason          String?
  anonymizedAt            DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  memberships             CompanyMembership[]
  assignments             StaffAssignment[]
  auditLogsAsActor        AuditLog[]             @relation("AuditActor")
  auditLogsAsTarget       AuditLog[]             @relation("AuditTarget")
  syncRuns                SyncRun[]
  invitationCodesCreated  InvitationCode[]       @relation("InvitationCodeCreator")
  invitationCodesUsed     InvitationCode[]       @relation("InvitationCodeUser")
  suspendedBy             User?                  @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers          User[]                 @relation("UserSuspendedBy")
  deletedBy               User?                  @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers            User[]                 @relation("UserDeletedBy")
  companiesSuspended      Company[]              @relation("CompanySuspendedBy")
  cleaningTasksAssigned   CleaningTask[]         @relation("CleaningTaskAssignee")
  cleaningTasksAssignedBy CleaningTask[]         @relation("CleaningTaskAssignedBy")
  cleaningTasksStarted    CleaningTask[]         @relation("CleaningTaskStartedBy")
  cleaningTasksCompleted  CleaningTask[]         @relation("CleaningTaskCompletedBy")
  cleaningTaskLogs        CleaningTaskLog[]      @relation("CleaningTaskLogActor")
  cleaningPhotosUploaded  CleaningPhoto[]        @relation("CleaningPhotoUploader")
  roomNotesAuthored       RoomNote[]             @relation("RoomNoteAuthor")
  roomNotesCompleted      RoomNote[]             @relation("RoomNoteCompletedBy")
  developerRoleSessions   DeveloperRoleSession[]
  reviewSyncLogs          ReviewSyncLog[]        @relation("ReviewSyncActor")

  @@index([isActive, name])
  @@index([status, createdAt])
  @@index([suspendedById])
  @@index([deletedById])
}

model CompanyMembership {
  id               String            @id @default(cuid())
  userId           String
  companyId        String
  role             CompanyMemberRole
  status           MembershipStatus  @default(ACTIVE)
  disabledAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyAccesses PropertyAccess[]

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@index([companyId, status, role])
  @@index([userId])
}

model PropertyAccess {
  id           String            @id @default(cuid())
  membershipId String
  propertyId   String
  createdAt    DateTime          @default(now())
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([membershipId, propertyId])
  @@index([propertyId])
}

model InvitationCode {
  id          String               @id @default(cuid())
  companyId   String
  role        CompanyMemberRole    @default(ADMIN)
  codeHash    String               @unique
  codePrefix  String
  status      InvitationCodeStatus @default(ACTIVE)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime             @default(now())
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  updatedAt   DateTime             @updatedAt
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("InvitationCodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy      User?                @relation("InvitationCodeUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([expiresAt])
  @@index([usedById])
}

model StaffAssignment {
  id         String    @id @default(cuid())
  userId     String
  propertyId String?
  roomId     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId, roomId])
  @@index([userId])
  @@index([propertyId])
  @@index([roomId])
}

model AuditLog {
  id              String   @id @default(cuid())
  actorUserId     String
  targetUserId    String?
  targetCompanyId String?
  action          String
  reason          String?
  details         Json?
  createdAt       DateTime @default(now())
  actor           User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target          User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetCompany   Company? @relation(fields: [targetCompanyId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetCompanyId, createdAt])
  @@index([action, createdAt])
}

model DeveloperRoleSession {
  id              String            @id @default(cuid())
  tokenHash       String            @unique
  developerUserId String
  previewRole     CompanyMemberRole
  companyId       String
  propertyScope   Json
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  developer       User              @relation(fields: [developerUserId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([developerUserId, expiresAt])
  @@index([companyId, expiresAt])
  @@index([revokedAt, expiresAt])
}

model CalendarSource {
  id                       String                   @id @default(cuid())
  roomId                   String
  provider                 CalendarProviderType
  name                     String
  calendarUrl              String
  isActive                 Boolean                  @default(true)
  connectionStatus         CalendarConnectionStatus @default(NORMAL)
  safetyReasonCodes        Json?
  feedFingerprint          Json?
  feedFingerprintUpdatedAt DateTime?
  lastSyncedAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  room                     Room                     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservations             Reservation[]
  syncLogs                 SyncLog[]

  @@unique([roomId, calendarUrl])
  @@index([roomId, isActive])
  @@index([provider, isActive])
  @@index([connectionStatus, isActive])
  @@index([isActive, lastSyncedAt])
}

model RoomListing {
  id                String               @id @default(cuid())
  roomId            String
  provider          CalendarProviderType
  listingUrl        String
  externalListingId String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  room              Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reviewSnapshots   ReviewSnapshot[]
  reviews           ListingReview[]
  syncLogs          ReviewSyncLog[]

  @@unique([roomId, provider])
  @@index([roomId, isActive])
  @@index([provider, isActive])
}

model ReviewSnapshot {
  id               String      @id @default(cuid())
  roomListingId    String
  sourceListingUrl String
  rating           Decimal?    @db.Decimal(5, 2)
  reviewCount      Int?
  collectedAt      DateTime    @default(now())
  roomListing      RoomListing @relation(fields: [roomListingId], references: [id], onDelete: Cascade)

  @@index([roomListingId, collectedAt])
  @@index([roomListingId, sourceListingUrl, collectedAt])
}

model ListingReview {
  id               String      @id @default(cuid())
  roomListingId    String
  sourceListingUrl String
  providerReviewId String?
  reviewerName     String?
  rating           Decimal?    @db.Decimal(5, 2)
  content          String?
  reviewedAt       DateTime?
  fingerprint      String
  collectedAt      DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  roomListing      RoomListing @relation(fields: [roomListingId], references: [id], onDelete: Cascade)

  @@unique([roomListingId, fingerprint])
  @@index([roomListingId, reviewedAt])
  @@index([roomListingId, sourceListingUrl, reviewedAt])
}

model ReviewSyncLog {
  id                 String               @id @default(cuid())
  roomListingId      String
  actorUserId        String?
  provider           CalendarProviderType
  sourceListingUrl   String
  status             SyncStatus           @default(RUNNING)
  startedAt          DateTime             @default(now())
  finishedAt         DateTime?
  fetchedReviewCount Int                  @default(0)
  newReviewCount     Int                  @default(0)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime             @default(now())
  roomListing        RoomListing          @relation(fields: [roomListingId], references: [id], onDelete: Cascade)
  actor              User?                @relation("ReviewSyncActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([roomListingId, startedAt])
  @@index([status, startedAt])
  @@index([actorUserId, startedAt])
}

model SyncRun {
  id            String            @id @default(cuid())
  roomId        String
  actorUserId   String?
  executionMode SyncExecutionMode
  status        SyncStatus        @default(RUNNING)
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  targetCount   Int               @default(0)
  successCount  Int               @default(0)
  failedCount   Int               @default(0)
  errorSummary  String?
  createdAt     DateTime          @default(now())
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actor         User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  syncLogs      SyncLog[]

  @@index([roomId, startedAt])
  @@index([status, startedAt])
  @@index([actorUserId, startedAt])
}

model ErrorLog {
  id          String   @id @default(cuid())
  digest      String?
  status      Int
  errorCode   String
  message     String
  stack       String?
  apiRoute    String?
  routeType   String?
  prismaError String?
  sqlError    String?
  createdAt   DateTime @default(now())

  @@index([digest, createdAt])
  @@index([errorCode, createdAt])
  @@index([createdAt])
}

model Reservation {
  /// Application and calendar-sync services must enforce startDate < endDate.
  id                    String                @id @default(cuid())
  provider              CalendarProviderType
  providerReservationId String?
  propertyId            String
  roomId                String
  calendarSourceId      String
  createdBySyncLogId    String?
  guestName             String?
  summary               String?
  description           String?
  startDate             DateTime
  endDate               DateTime
  status                ReservationStatus
  rawUid                String
  providerCreatedAt     DateTime?
  providerUpdatedAt     DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  property              Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room                  Room                  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  calendarSource        CalendarSource        @relation(fields: [calendarSourceId], references: [id], onDelete: Restrict)
  createdBySyncLog      SyncLog?              @relation("ReservationCreatedBySyncLog", fields: [createdBySyncLogId], references: [id], onDelete: SetNull)
  conflictsAsA          ReservationConflict[] @relation("ConflictReservationA")
  conflictsAsB          ReservationConflict[] @relation("ConflictReservationB")
  cleaningTasks         CleaningTask[]

  @@unique([calendarSourceId, rawUid])
  @@index([roomId, startDate, endDate])
  @@index([propertyId, startDate, endDate])
  @@index([startDate, status])
  @@index([endDate, status])
  @@index([calendarSourceId, status])
  @@index([createdBySyncLogId])
  @@index([provider, startDate])
  @@index([provider, providerReservationId])
}

model CleaningTask {
  id              String             @id @default(cuid())
  companyId       String
  propertyId      String
  roomId          String
  reservationId   String?
  scheduledDate   DateTime
  status          CleaningTaskStatus @default(PENDING)
  assignedToId    String?
  assigneeName    String?
  assignedById    String?
  assignedAt      DateTime?
  startedById     String?
  startedByName   String?
  startedAt       DateTime?
  completedAt     DateTime?
  completedById   String?
  completedByName String?
  cleanerName     String?
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room            Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservation     Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  assignedTo      User?              @relation("CleaningTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy      User?              @relation("CleaningTaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  startedBy       User?              @relation("CleaningTaskStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy     User?              @relation("CleaningTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  photos          CleaningPhoto[]
  logs            CleaningTaskLog[]
  roomNote        RoomNote?

  @@unique([reservationId, roomId])
  @@index([companyId, status, scheduledDate])
  @@index([companyId, status, completedAt])
  @@index([propertyId, status, scheduledDate])
  @@index([propertyId, status, completedAt])
  @@index([roomId, scheduledDate])
  @@index([assignedToId, scheduledDate, status])
  @@index([assignedById, assignedAt])
  @@index([startedById, startedAt])
  @@index([status, scheduledDate])
  @@index([companyId, status, cleanerName, completedAt])
}

model CleaningWorker {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  normalizedName String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, normalizedName])
  @@index([companyId, isActive, name])
}

model CleaningTaskLog {
  id             String                @id @default(cuid())
  taskId         String
  action         CleaningTaskLogAction
  actorUserId    String?
  workerName     String?
  previousStatus CleaningTaskStatus?
  nextStatus     CleaningTaskStatus?
  details        Json?
  createdAt      DateTime              @default(now())
  task           CleaningTask          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor          User?                 @relation("CleaningTaskLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model CleaningPhoto {
  id             String       @id @default(cuid())
  taskId         String
  clientUploadId String?
  storageKey     String?      @unique
  originalName   String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  uploadedById   String
  createdAt      DateTime     @default(now())
  deleteAfter    DateTime?
  deletedAt      DateTime?
  deleteError    String?
  deleteAttempts Int          @default(0)
  task           CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("CleaningPhotoUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([taskId, clientUploadId])
  @@index([taskId, createdAt])
  @@index([deleteAfter, deletedAt])
  @@index([uploadedById, createdAt])
}

/// Manual notes keep their content here. Cleaning note rows contain only
/// source/status metadata; their content and photos remain on CleaningTask.
model RoomNote {
  id                String             @id @default(cuid())
  companyId         String
  propertyId        String
  roomId            String
  authorUserId      String?
  authorName        String
  content           String?
  sourceType        RoomNoteSourceType @default(MANUAL)
  cleaningTaskId    String?            @unique
  status            RoomNoteStatus     @default(OPEN)
  completedAt       DateTime?
  completedByUserId String?
  completedByName   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room              Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  author            User?              @relation("RoomNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  completedBy       User?              @relation("RoomNoteCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cleaningTask      CleaningTask?      @relation(fields: [cleaningTaskId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt, id])
  @@index([propertyId, status, createdAt, id])
  @@index([roomId, status, createdAt, id])
  @@index([authorUserId, createdAt])
  @@index([completedByUserId, completedAt])
}

model ReservationConflict {
  id             String                    @id @default(cuid())
  roomId         String
  reservationAId String
  reservationBId String
  status         ReservationConflictStatus @default(ACTIVE)
  overlapStart   DateTime
  overlapEnd     DateTime
  detectedAt     DateTime                  @default(now())
  lastDetectedAt DateTime                  @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  room           Room                      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservationA   Reservation               @relation("ConflictReservationA", fields: [reservationAId], references: [id], onDelete: Restrict)
  reservationB   Reservation               @relation("ConflictReservationB", fields: [reservationBId], references: [id], onDelete: Restrict)

  @@unique([reservationAId, reservationBId])
  @@index([roomId, status])
  @@index([reservationAId, status])
  @@index([reservationBId, status])
  @@index([status, overlapStart, overlapEnd])
}

model SyncLog {
  /// Service input validation must keep all count fields at zero or greater.
  id                    String               @id @default(cuid())
  calendarSourceId      String
  syncRunId             String?
  provider              CalendarProviderType
  status                SyncStatus
  startedAt             DateTime             @default(now())
  completedAt           DateTime?
  fetchedCount          Int                  @default(0)
  parsedEventCount      Int                  @default(0)
  reservationEventCount Int                  @default(0)
  blockedEventCount     Int                  @default(0)
  cancelledEventCount   Int                  @default(0)
  unknownEventCount     Int                  @default(0)
  unknownEventDetails   Json?
  failedEventCount      Int                  @default(0)
  eventDiagnostics      Json?
  feedFingerprint       Json?
  safetyDiagnostics     Json?
  quarantined           Boolean              @default(false)
  skippedEventCount     Int                  @default(0)
  createdCount          Int                  @default(0)
  updatedCount          Int                  @default(0)
  cancelledCount        Int                  @default(0)
  errorMessage          String?
  retryCount            Int                  @default(0)
  httpStatus            Int?
  errorCode             String?
  errorDetails          String?
  durationMs            Int?
  createdAt             DateTime             @default(now())
  calendarSource        CalendarSource       @relation(fields: [calendarSourceId], references: [id], onDelete: Restrict)
  syncRun               SyncRun?             @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  createdReservations   Reservation[]        @relation("ReservationCreatedBySyncLog")

  @@index([calendarSourceId, createdAt])
  @@index([syncRunId, createdAt])
  @@index([status, createdAt])
